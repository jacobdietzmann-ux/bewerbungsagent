[Unit]
Description=Bewerbungsagent Wochenlauf (Suche, Bewertung, Unterlagen, Dashboard)
# Ohne Netz kann weder gesucht noch geladen werden — der Lauf würde nur
# fehlschlagen. Also auf die Verbindung warten.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Arbeitsverzeichnis = Agent-Ordner; darin liegt config.json und das Paket.
WorkingDirectory=%h/GoogleDrive/DOKUMENTE/Job/Bewerbung/2026/04_Agent
ExecStart=%h/git/bewerbungsagent/scripts/wochenlauf.sh %h/GoogleDrive/DOKUMENTE/Job/Bewerbung/2026/04_Agent
# Der Lauf dauert (Browser-Fetches) — großzügig bemessen, damit systemd nicht
# abbricht, während noch gearbeitet wird.
TimeoutStartSec=3600
# Ein einzelner Fehlschlag soll den Lauf nicht als "aktiv" hängen lassen.
RemainAfterExit=no
