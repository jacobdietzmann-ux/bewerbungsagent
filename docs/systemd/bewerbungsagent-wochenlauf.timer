[Unit]
Description=Wöchentlicher Bewerbungsagent-Lauf (Montag früh)

[Timer]
# Montag 06:00. Bewusst früh: die Stellen und Unterlagen liegen dann vor dem
# Arbeitsbeginn bereit. ``Persistent=true`` holt einen verpassten Lauf nach
# (z. B. wenn der Rechner montags aus war) — wichtig, damit kein Montag ausfällt.
OnCalendar=Mon *-*-* 06:00:00
Persistent=true
# Streuung: verhindert, dass alle Timer exakt gleichzeitig starten.
RandomizedDelaySec=600
# Nach dem Aufholen nicht sofort wieder feuern.
Unit=bewerbungsagent-wochenlauf.service

[Install]
WantedBy=timers.target
